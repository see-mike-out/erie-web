{
  "name": "erie-web",
  "version": "1.0.5",
  "description": "A declarative grammar for data sonification for web",
  "main": "dist/index.js",
  "module": "build/erie-web-esm.js",
  "types": "dist/src/index.d.ts",
  "unpkg": "build/erie-web.min.js",
  "jsdelivr": "build/erie-web.min.js",
  "browser": {
    "build/erie-web.min.js": "build/erie-web-umd.min.js"
  },
  "exports": {
    "node": "./build/erie-web-node.js",
    "default": "./build/erie-web-esm.js"
  },
  "scripts": {
    "test": "vitest",
    "build": "rm -rf dist && tsc  --project tsconfig.build.json && rollup -c && scripts/post_build.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/see-mike-out/erie-web.git"
  },
  "keywords": [
    "data",
    "sonification"
  ],
  "author": "Hyeok Kim",
  "bugs": {
    "url": "https://github.com/see-mike-out/erie-web/issues"
  },
  "homepage": "https://see-mike-out.github.io/erie-documentation",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-multi-entry": "^6.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.0.0",
    "@types/vega": "^0.0.30",
    "standardized-audio-context": "^25.3.77",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "arquero": "^5.2.0",
    "d3": "^7.8.4",
    "vega": "^6.4.0"
  },
  "esm": {
    "cjs": true,
    "await": true
  }
}